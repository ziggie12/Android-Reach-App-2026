# Munandy Reach Backend — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit the real .env.

NODE_ENV=development

# JWT signing secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Server port (default: 3000)
PORT=3000

# Interface to bind (optional). On a VPS behind Apache/nginx use 127.0.0.1 so the
# port is only reachable through the proxy. Leave blank for LAN testing.
HOST=

# Allowed CORS origin (default: * — restrict in production)
CORS_ORIGIN=*

# Twilio — WhatsApp notifications (optional, leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number (default if blank): +14155238886
TWILIO_WHATSAPP_FROM=
