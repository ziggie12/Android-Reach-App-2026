<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override: permits cleartext HTTP so debug builds can reach a local
  dev server (e.g. http://192.168.1.x:3000). This file exists only in the debug
  source set, so release builds keep the HTTPS-only policy from src/main.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
